{
	"name": "companion-surface-comms-remote",
	"version": "0.2.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"package": "run build && run dist",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"dist": "companion-surface-build",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"test": "node --test \"test/*.test.mjs\""
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nisted/companion-surface-comms-remote.git"
	},
	"engines": {
		"node": "^22.18",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-surface/base": "1.4.1"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.0",
		"@types/node": "^22.20.4",
		"rimraf": "^6.1.3",
		"typescript": "~5.9.3"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.18.1"
}
